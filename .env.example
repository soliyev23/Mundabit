# @BotFather dan olingan token
BOT_TOKEN=<@BotFather dan olingan token>

# Ixtiyoriy sozlamalar (standart qiymatlari ko'rsatilgan)
# O'zbekiston o'rtacha umr ko'rish yoshi, jins bo'yicha
LIFE_EXPECTANCY_MALE=72
LIFE_EXPECTANCY_FEMALE=76
LIFE_EXPECTANCY_DEFAULT=74
TIMEZONE=Asia/Tashkent
# Dushanba: hafta yakuni so'rovi
NOTIFY_DAY_OF_WEEK=mon
NOTIFY_HOUR=8
NOTIFY_MINUTE=0
# Juma: kalendar oynasi (13:00 dan boshlab, BROADCAST_WINDOW_MINUTES davomida yoyiladi)
CALENDAR_DAY_OF_WEEK=fri
CALENDAR_HOUR=13
CALENDAR_MINUTE=0
BROADCAST_WINDOW_MINUTES=60
# Admin Telegram ID'lari (vergul bilan; birinchisi asosiy — yangi user xabari unga boradi)
ADMIN_IDS=<telegram id, vergul bilan>

# English: tuzilgan gapni tekshirish (https://console.groq.com). Bo'sh — o'chiq.
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# Mini App (Telegram Web App) — HTTPS manzil kerak (masalan, cloudflared tunnel).
# Bo'sh qoldirilsa, botda Mini App tugmasi ko'rsatilmaydi.
WEBAPP_URL=
WEBAPP_PORT=8080
